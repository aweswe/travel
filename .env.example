# ==============================================================
# Collabcar - Vercel & Production Environment Variables Template
# ==============================================================

# --------------------------------------------------------------
# 1. DeepSeek AI Configuration (MANDATORY for AI Trip Planner)
# --------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --------------------------------------------------------------
# 2. Public Access & Authentication Control
# --------------------------------------------------------------
# Set to 'false' so public visitors can generate AI itineraries without logging in
NEXT_PUBLIC_REQUIRE_LOGIN=false

# --------------------------------------------------------------
# 3. Canonical Domain & SEO Metadata
# --------------------------------------------------------------
# Optional: If omitted, the app dynamically uses VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL
NEXT_PUBLIC_SITE_URL=https://collabcar.com

# --------------------------------------------------------------
# 4. PocketBase Database (OPTIONAL)
# --------------------------------------------------------------
# If running without an external PocketBase instance on Vercel, leave empty/commented.
# The trip planner, blog, SEO, and continuous PDF reader will operate 100% standalone.
# If you host PocketBase externally (e.g. Fly.io, PocketHost, Render, EC2), set:
# POCKETBASE_URL=https://your-pocketbase.fly.dev
# NEXT_PUBLIC_POCKETBASE_URL=/hcgi/platform
# PB_SUPERUSER_EMAIL=admin@collabcar.com
# PB_SUPERUSER_PASSWORD=your_secure_password
