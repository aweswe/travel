{
  "name": "collabcar-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"PB,NEXT\" -c \"yellow,cyan\" \"npm run pb:dev\" \"npm run dev:next\"",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "start:all": "concurrently -k -p \"[{name}]\" -n \"PB,NEXT\" -c \"yellow,cyan\" \"npm run pb:dev\" \"npm run start\"",
    "lint": "next lint",
    "pb:dev": "./pocketbase/pocketbase serve --http=127.0.0.1:8090 --dir=./pocketbase/pb_data --migrationsDir=./pocketbase/pb_migrations --hooksDir=./pocketbase/pb_hooks",
    "pb:migrate": "./pocketbase/pocketbase migrate up --dir=./pocketbase/pb_data --migrationsDir=./pocketbase/pb_migrations --hooksDir=./pocketbase/pb_hooks"
  },
